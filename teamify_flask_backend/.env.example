# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5022

# Optional Redis for rate limiting + caching (falls back to in-memory when unset)
# REDIS_URL=redis://localhost:6379/0

# --- Database ---
DATABASE_URL=sqlite:///app.db

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- OAuth (Google / GitHub social login) ---
# Google: must match the OAuth 2.0 Web client ID used by the Flutter app.
# In Google Cloud Console also add Authorized JavaScript origins:
#   http://localhost:8080
# And Authorized redirect URIs:
#   http://localhost:8080/
GOOGLE_CLIENT_ID=854339507790-tntdbhvs0onvvpms12frchr32mq4eud5.apps.googleusercontent.com
# GitHub: create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match the Flutter app exactly, e.g.:
#   http://localhost:8080/
GITHUB_CLIENT_ID=Ov23liRUeYFAPsv1xgtd
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# --- Symmetric encryption (Fernet) ---
# Generate with: python scripts/generate_fernet_key.py
FERNET_KEY=
# Optional: previous key — kept readable during rotation
FERNET_KEY_OLD=

# --- File storage ---
# Directory where Fernet-encrypted uploads are written (created on startup)
UPLOAD_DIR=./instance/uploads

# --- AI / ML Model Settings ---
# Absolute or relative path to the ml_models/ directory.
# Defaults to teamify_flask_backend/ml_models/ when unset.
AI_MODELS_DIR=./ml_models

# Set to "false" to disable all .pkl model inference and use heuristic fallbacks only.
# Useful for CI/test environments where heavy model files are not present.
AI_ENABLE_LOCAL_MODELS=true

# Speech-to-Text microservice base URL (FastAPI/Whisper — separate process).
# Start it with: cd ml_models && uvicorn app:app --port 8000
STT_SERVICE_URL=http://localhost:8000

# Optional: Anthropic Claude API key for AI-generated mentor reports.
# Leave blank to use the built-in rule-based report generator.
ANTHROPIC_API_KEY=

# --- Outbound email (SMTP) ---
# Required for password-reset OTP emails and invitation/connection emails.
# Gmail example: host smtp.gmail.com, port 587, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Sender shown to recipients (defaults to SMTP_USERNAME)
MAIL_FROM=
MAIL_FROM_NAME=Teamify
